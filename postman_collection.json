{
  "info": {
    "name": "EduTask API - ClassRoom & Enrollment",
    "description": "Postman collection untuk testing ClassRoom dan Enrollment endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Class (Lecturer)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer YOUR_JWT_TOKEN_HERE"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Web Development 101\",\n  \"description\": \"Belajar web development dari dasar\",\n  \"max_students\": 30,\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/classes",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "classes"]
        }
      }
    },
    {
      "name": "2. List All Classes",
